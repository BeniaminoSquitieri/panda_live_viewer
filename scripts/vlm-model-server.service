[Unit]
Description=Persistent VLM Model Server (Qwen3-VL-32B)
Documentation=https://github.com/BeniaminoSquitieri/panda_live_viewer
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/VLM-BT-BC/panda_live_viewer

# Install as a user service. Override defaults in
# ~/.config/lerobot-vlm.env (KEY=value, one per line).
Environment=VLM_MODEL_PATH=Qwen/Qwen3-VL-32B-Instruct
EnvironmentFile=-%h/.config/lerobot-vlm.env
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

ExecStart=/usr/bin/env python3 -u -m vlm_live.model_server --model-path ${VLM_MODEL_PATH} --socket-path %h/VLM-BT-BC/panda_live_viewer/runtime/vlm_server.sock

# Restart automatically if the process crashes (not on clean exit/kill)
Restart=on-failure
RestartSec=15

# Allow enough time to load the 32B model into GPU
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vlm-model-server

[Install]
WantedBy=multi-user.target
